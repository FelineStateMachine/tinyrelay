# Add to the relay host's Caddyfile. The edge machine reaches this listener
# over the tailnet only; the port is not published anywhere else.
http://012.run:8080, http://*.012.run:8080 {
  reverse_proxy 127.0.0.1:7447
  @signerQR path /qr.svg /r/*/qr.svg
  log_skip @signerQR
  log {
    output file /logs/access.json {
      roll_size 10MiB
      roll_keep 7
    }
    format json
  }
}
